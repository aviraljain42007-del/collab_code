PORT=3000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

AUTH_DB_NAME=auth_db
ROOM_DB_NAME=room_db
EXECUTION_DB_NAME=execution_db

JWT_ACCESS_SECRET=dev-access-secret-change-this-to-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-this-to-32-plus-chars
JWT_REFRESH_TTL_DAYS=7